# ==============================================================================
# InvoicePilot AI — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your environment.
# NEVER commit your real .env file with live secrets to Git.

# Application Settings
APP_NAME=InvoicePilot AI
APP_ENV=production
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=https://your-frontend-service.onrender.com,http://localhost:5173

# Database Connection
# Option A (Demo / Local): SQLite (Note: Ephemeral on Render Free Tier)
DATABASE_URL=sqlite:///./invoicepilot.db
# Option B (Production): Render Managed PostgreSQL or external PostgreSQL
# DATABASE_URL=postgresql://username:password@dpg-xxxxx.oregon-postgres.render.com/invoicepilot_db

# PayPal Developer Sandbox Integration
# Obtain credentials from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id

# AI / LLM Configuration
# In Render Cloud (where local Ollama daemon is absent), default to deterministic fallback:
AI_PROVIDER=deterministic
AI_MODEL=heuristic_regex_v2

# Security & Session
SECRET_KEY=generate_a_secure_random_32_character_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

